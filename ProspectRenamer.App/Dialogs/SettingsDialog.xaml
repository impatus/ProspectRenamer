<Window x:Class="ProspectRenamer.App.Dialogs.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="610"
        Height="340"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="{StaticResource PanelBrush}" Padding="26">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="LOCAL SETTINGS" FontSize="18" FontWeight="SemiBold" />

            <CheckBox Grid.Row="1"
                      Content="Show safety warning before renaming"
                      IsChecked="{Binding ShowRenameWarning}"
                      Margin="0,24,0,0" />

            <StackPanel Grid.Row="2" Margin="0,22,0,0">
                <TextBlock Text="BACKUP LOCATION" FontSize="9" Foreground="{StaticResource MutedTextBrush}" />
                <Grid Margin="0,7,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding BackupFolder, UpdateSourceTrigger=PropertyChanged}" FontSize="11" VerticalContentAlignment="Center" />
                    <Button Grid.Column="1" Content="BROWSE" Click="Browse_Click" Margin="8,0,0,0" />
                </Grid>
                <TextBlock Text="Leave blank to use %LOCALAPPDATA%\ProspectRenamer\Backups"
                           Foreground="{StaticResource MutedTextBrush}" FontSize="9" Margin="0,6,0,0" />
            </StackPanel>

            <TextBlock Grid.Row="3"
                       Text="Preferences stay on this PC. Prospect Renamer does not use network services or telemetry."
                       Foreground="#73878C" FontSize="10" VerticalAlignment="Bottom" Margin="0,0,0,18" />

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="CANCEL" IsCancel="True" Margin="0,0,8,0" />
                <Button Content="SAVE" Style="{StaticResource AccentButton}" IsDefault="True" Click="Save_Click" MinWidth="100" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
