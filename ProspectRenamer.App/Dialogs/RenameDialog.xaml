<Window x:Class="ProspectRenamer.App.Dialogs.RenameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rename or Duplicate Prospect"
        Width="700"
        Height="470"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="{StaticResource PanelBrush}" Padding="26">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="RENAME OR DUPLICATE" FontSize="18" FontWeight="SemiBold" />
            <StackPanel Grid.Row="1" Margin="0,24,0,0">
                <TextBlock Text="CURRENT NAME" FontSize="9" Foreground="{StaticResource MutedTextBrush}" />
                <TextBlock Text="{Binding CurrentName}" FontSize="14" Margin="0,6,0,0" />
            </StackPanel>
            <StackPanel Grid.Row="2" Margin="0,20,0,0">
                <TextBlock Text="NEW NAME" FontSize="9" Foreground="{StaticResource MutedTextBrush}" />
                <TextBox x:Name="NameBox"
                         Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,7,0,0"
                         MaxLength="250" />
                <TextBlock Text="{Binding ValidationMessage}"
                           Foreground="{StaticResource ErrorBrush}"
                           FontSize="10"
                           Margin="0,6,0,0"
                           MinHeight="14" />
            </StackPanel>
            <Border Grid.Row="3" Background="#0B1519" BorderBrush="#24383E" BorderThickness="1" Padding="12" Margin="0,14,0,14">
                <StackPanel>
                    <TextBlock Text="RENAME creates a new ProspectID and removes the old local file. DUPLICATE keeps both files."
                               TextWrapping="Wrap" FontSize="10" Foreground="#B9C8CA" FontWeight="SemiBold" />
                    <TextBlock Text="RENAME migrates matching local loadouts and archives the old Icarus autosaves outside the live folder, preventing the old name from being restored. DUPLICATE leaves both untouched."
                               TextWrapping="Wrap" FontSize="10" Foreground="#899B9F" Margin="0,7,0,0" LineHeight="15" />
                </StackPanel>
            </Border>
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="CANCEL" IsCancel="True" Margin="0,0,8,0" />
                <Button Content="DUPLICATE / KEEP OLD"
                        IsEnabled="{Binding CanRename}"
                        Click="Duplicate_Click"
                        Margin="0,0,8,0"
                        MinWidth="156" />
                <Button Content="RENAME / REMOVE OLD"
                        Style="{StaticResource AccentButton}"
                        IsDefault="True"
                        IsEnabled="{Binding CanRename}"
                        Click="Rename_Click"
                        MinWidth="162" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
